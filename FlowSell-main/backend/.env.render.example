NODE_ENV=production

# Reemplazar las tres apariciones por la URL definitiva del Web Service.
APP_URL=https://tu-servicio.onrender.com
REDIRECT_URI=https://tu-servicio.onrender.com/api/auth/callback
REACT_APP_HOST_HOOKS=https://tu-servicio.onrender.com

# No definir PORT: Render lo proporciona automáticamente.
# Dejar COOKIE_DOMAIN sin configurar cuando frontend y backend comparten origen.
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
MONGO_URI=mongodb+srv://usuario:password@cluster/flowsell?retryWrites=true&w=majority

CLIENT_ID=
CLIENT_SECRET=

# Internal URL de Render Key Value o una URL Redis equivalente.
REDIS_URL=redis://usuario:password@host:6379

# Settings > API Keys en la consola de Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flowsell/templates

GENERATE_SOURCEMAP=false
