NODE_ENV=development
PORT=8080

# URLs públicas
APP_URL=http://localhost:3000
REDIRECT_URI=http://localhost:8080/api/auth/callback
# Dejar vacío en local. Ejemplo de producción: .tudominio.com
COOKIE_DOMAIN=

# Sesiones y datos
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
MONGO_URI=mongodb://127.0.0.1:27017/flowsell

# Aplicación de Mercado Libre
CLIENT_ID=
CLIENT_SECRET=
CLIENT_ID_PERMITIDO=

# Redis para webhooks, mensajes diferidos, campañas y seguimiento.
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary: Settings > API Keys en la consola de Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional. No usar barra al comienzo ni al final.
CLOUDINARY_FOLDER=flowsell/templates
