NODE_ENV=development
PORT=8080

# URLs públicas
APP_URL=http://localhost:3000
REDIRECT_URI=http://localhost:8080/api/auth/callback
# Dejar vacío en local. Ejemplo de producción: .tudominio.com
COOKIE_DOMAIN=

# Sesiones y datos
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio
MONGO_URI=mongodb://127.0.0.1:27017/flowsell

# Aplicación de Mercado Libre
CLIENT_ID=
CLIENT_SECRET=
CLIENT_ID_PERMITIDO=

# Redis principal (webhooks y mensajes diferidos)
REACT_APP_HOST_REDIS=127.0.0.1
REACT_APP_PORT_REDIS=6379

# Redis para campañas y seguimiento. Puede apuntar a la misma instancia.
REDIS_URL=redis://127.0.0.1:6379
REACT_APP_HOST_REDIS_TRACKING=127.0.0.1
REACT_APP_PORT_REDIS_TRACKING=6379
REACT_APP_REDIS_PASSWORD_TRACKING=

# Firebase Admin / Storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
