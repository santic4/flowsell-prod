# Sólo backend. Copiar a .env local o cargar cada variable en Render.
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
REDIRECT_URI=http://localhost:8080/api/auth/callback
CLIENT_ID=
CLIENT_SECRET=
MELI_PKCE=false
MONGO_URI=
REDIS_URL=
# Generar con npm run secrets. No reutilizar los ejemplos como credenciales.
SESSION_SECRET=
WEBHOOK_SECRET=
TOKEN_ENCRYPTION_ACTIVE_KEY=v1
TOKEN_ENCRYPTION_KEYS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=flowsell/templates
CLOUDINARY_GLOBAL_MONTHLY_MB=100000
# ID del vendedor administrador, no CLIENT_ID.
ADMIN_MELI_IDS=
ADMIN_TOTP_SECRET=
RUN_WORKERS=true
PREMIUM_PRICE_USD=19
PLUS_PRICE_USD=39
# Estos datos se muestran públicamente; nunca poner secretos aquí.
LEGAL_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
LEGAL_EMAIL=
DATA_REGIONS=
LEGAL_READY=false
